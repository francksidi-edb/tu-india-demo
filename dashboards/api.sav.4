def run_psql_file(sql_path: Path, preset: dict, timeout: int = 600):
    """Run a .sql file via the psql CLI against a connection preset. Returns CompletedProcess."""
    env = os.environ.copy()
    env["PGPASSWORD"] = preset["password"]
    cmd = [
        "psql", "-h", preset["host"], "-p", str(preset["port"]),
        "-U", preset["user"], "-d", preset["database"],
        "-v", "ON_ERROR_STOP=1", "-f", str(sql_path),
    ]
    return subprocess.run(cmd, capture_output=True, text=True, env=env, timeout=timeout)


@app.route("/api/madlib/train", methods=["POST"])
def madlib_train():
    """Run the MADlib training/scoring SQL script against WarehousePG (tu db)."""
    if not MADLIB_SQL_PATH.exists():
        return jsonify({"ok": False, "error": f"SQL script not found: {MADLIB_SQL_PATH}"}), 400
    try:
        r = run_psql_file(MADLIB_SQL_PATH, SQL_CONN_PRESETS["whpg_tu"])
        output = (r.stdout or "") + (r.stderr or "")
        return jsonify({"ok": r.returncode == 0, "output": output[-6000:]})
    except FileNotFoundError:
        return jsonify({"ok": False, "error": "psql not found in PATH"}), 400
    except subprocess.TimeoutExpired:
        return jsonify({"ok": False, "error": "Training timed out after 600s"}), 504
    except Exception as e:
        return jsonify({"ok": False, "error": str(e)}), 400


@app.route("/api/madlib/status")
def madlib_status():
    """Whether a model exists, its fit stats, and the risk-tier distribution."""
    try:
        conn = get_sql_conn("whpg_tu")
        cur = conn.cursor(cursor_factory=psycopg2.extras.RealDictCursor)

        cur.execute("SELECT to_regclass('tu_bureau_demo.credit_risk_model') IS NOT NULL AS exists")
        model_exists = cur.fetchone()["exists"]

        result = {"ok": True, "model_exists": bool(model_exists)}

        try:
            cur.execute("SELECT count(*) AS n FROM tu_bureau_demo.credit_risk_features")
            result["feature_rows"] = cur.fetchone()["n"]
        except Exception:
            result["feature_rows"] = 0

        if model_exists:
            try:
                cur.execute("""
                    SELECT log_likelihood, iteration_count, num_rows_processed, num_rows_skipped
                    FROM tu_bureau_demo.credit_risk_model LIMIT 1""")
                m = cur.fetchone()
                if m:
                    result["log_likelihood"] = _jsonable(m.get("log_likelihood"))
                    result["iterations"] = _jsonable(m.get("iteration_count"))
                    result["rows_processed"] = _jsonable(m.get("num_rows_processed"))
                    result["rows_skipped"] = _jsonable(m.get("num_rows_skipped"))
            except Exception as e:
                result["model_summary_error"] = str(e)

            try:
                cur.execute("""
                    SELECT risk_tier, count(*) AS n,
                           round(avg(probability_delinquent)::numeric, 3) AS avg_probability
                    FROM tu_bureau_demo.credit_risk_scores
                    GROUP BY risk_tier ORDER BY risk_tier""")
                result["tiers"] = [
                    {"risk_tier": r["risk_tier"], "count": r["n"], "avg_probability": float(r["avg_probability"] or 0)}
                    for r in cur.fetchall()
                ]
                cur.execute("SELECT count(*) AS n FROM tu_bureau_demo.credit_risk_scores")
                result["scored_count"] = cur.fetchone()["n"]
            except Exception as e:
                result["scores_error"] = str(e)

        cur.close(); conn.close()
        return jsonify(result)
    except Exception as e:
        return jsonify({"ok": False, "error": str(e)}), 400


