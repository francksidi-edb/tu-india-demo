@app.route("/api/generators/start", methods=["POST"])
def generators_start():
    """Start one or both generators."""
    body = request.get_json(silent=True) or {}

    # Update config if provided
    for k in ("ecom_rate", "iot_rate", "ecom_total", "iot_total"):
        if k in body:
            GEN_CONFIG[k] = int(body[k])

    started = []
    errors  = []

    gen_dir = REPO_DIR / "generators"
    ecom_bin = gen_dir / "order-generator"
    iot_bin  = gen_dir / "iot-generator"

    # Auto-build if missing
    if not ecom_bin.exists() or not iot_bin.exists():
        r = subprocess.run(["go", "build", "-o", "order-generator", "order-generator.go"],
                           capture_output=True, cwd=str(gen_dir))
        subprocess.run(["go", "build", "-o", "iot-generator", "iot-generator.go"],
                       capture_output=True, cwd=str(gen_dir))

    target = body.get("target", "both")   # both | ecom | iot

    if target in ("both", "ecom") and not read_pid("order-generator"):
        cmd = [str(ecom_bin),
               "-rate", str(GEN_CONFIG["ecom_rate"]),
               "-max-messages", str(GEN_CONFIG["ecom_total"])]
        pid = run_bg("order-generator", cmd, cwd=gen_dir)
        started.append(f"order-generator (PID {pid})")

    if target in ("both", "iot") and not read_pid("iot-generator"):
        cmd = [str(iot_bin),
               "-rate", str(GEN_CONFIG["iot_rate"]),
               "-max-messages", str(GEN_CONFIG["iot_total"])]
        pid = run_bg("iot-generator", cmd, cwd=gen_dir)
        started.append(f"iot-generator (PID {pid})")

    return jsonify({"ok": True, "started": started, "errors": errors,
                    "config": GEN_CONFIG})


@app.route("/api/generators/stop", methods=["POST"])
def generators_stop():
    body = request.get_json(silent=True) or {}
    target = body.get("target", "both")
    stopped = []
    if target in ("both", "ecom"):
        if kill_pid("order-generator"): stopped.append("order-generator")
    if target in ("both", "iot"):
        if kill_pid("iot-generator"):   stopped.append("iot-generator")
    return jsonify({"ok": True, "stopped": stopped})


@app.route("/api/generators/config", methods=["GET", "POST"])
def generators_config():
    if request.method == "POST":
        body = request.get_json(silent=True) or {}
        for k in ("ecom_rate", "iot_rate", "ecom_total", "iot_total"):
            if k in body:
                GEN_CONFIG[k] = int(body[k])
        return jsonify({"ok": True, "config": GEN_CONFIG})
    return jsonify(GEN_CONFIG)


@app.route("/api/generators/log/<name>")
def generator_log(name):
    allowed = {"order-generator", "iot-generator"}
    if name not in allowed:
        return jsonify({"error": "unknown generator"}), 400
    n = int(request.args.get("n", 30))
    return jsonify({"log": tail_log(name, n)})


# ══════════════════════════════════════════════════════════════════════════════
#  IoT BATCH LOAD  (gpfdist bulk load, separate from the Kafka streaming path)
#
#  Uses generate_iot_batch.py (a standalone script — see that file for its own
#  usage docs) to write ONE large CSV, then serves it via gpfdist and loads it
#  into public.iot_sensor_readings through a WarehousePG external table. This
#  mirrors real gpfdist usage: segments read ranges of a single file in
#  parallel, rather than the dashboard splitting rows into many small files.
# ══════════════════════════════════════════════════════════════════════════════

def find_gpfdist_bin() -> str:
    import shutil
    candidates = [
        GPFDIST_BIN_ENV,
        "/usr/local/greenplum-db-7.3.1-WHPG/bin/gpfdist",
        "/usr/local/bin/gpfdist",
        "/usr/bin/gpfdist",
        shutil.which("gpfdist") or "",
    ]
    for c in candidates:
        if c and os.path.isfile(c) and os.access(c, os.X_OK):
            return c
    return ""


def find_generate_script() -> Path:
    """Locate generate_iot_batch.py — checked in a few common repo locations."""
    candidates = [
        os.environ.get("GENERATE_IOT_BATCH_SCRIPT", ""),
        str(REPO_DIR / "generators" / "generate_iot_batch.py"),
        str(REPO_DIR / "scripts" / "generate_iot_batch.py"),
        str(REPO_DIR / "dashboards" / "generate_iot_batch.py"),
        str(Path(__file__).resolve().parent / "generate_iot_batch.py"),
    ]
    for c in candidates:
        if c and Path(c).is_file():
            return Path(c)
    return None


def _gpfdist_running() -> bool:
    return read_pid("gpfdist") is not None


def _port_in_use(host: str, port: int) -> bool:
    import socket
    try:
        with socket.create_connection((host, port), timeout=1):
            return True
    except OSError:
        return False


def _start_gpfdist() -> tuple:
    """Start gpfdist serving BATCH_LOAD_DIR, if not already running. Returns (ok, msg)."""
    if _gpfdist_running():
        return True, f"gpfdist already running (PID {read_pid('gpfdist')})"

    if _port_in_use(GPFDIST_HOST, GPFDIST_PORT):
        return False, (
            f"Port {GPFDIST_PORT} is already in use by another process — this batch loader needs "
            f"its own dedicated port. Note: FlowServer's own built-in gpfdist listener (for its "
            f"Kafka streaming jobs) typically occupies port 6070 by default, so this must be a "
            f"different port. Set the GPFDIST_PORT env var to a free port and restart the dashboard API."
        )

    gpfdist_bin = find_gpfdist_bin()
    if not gpfdist_bin:
        return False, "gpfdist binary not found (checked common paths and PATH)"
    BATCH_LOAD_DIR.mkdir(parents=True, exist_ok=True)
    pid = run_bg("gpfdist", [gpfdist_bin, "-d", str(BATCH_LOAD_DIR), "-p", str(GPFDIST_PORT)])
    time.sleep(1)
    if read_pid("gpfdist") is None:
        return False, f"gpfdist exited immediately — check {log_file('gpfdist')}"
    return True, f"gpfdist started (PID {pid}) serving {BATCH_LOAD_DIR} on port {GPFDIST_PORT}"


def _stop_gpfdist() -> str:
    return "gpfdist stopped" if kill_pid("gpfdist") else "gpfdist was not running"


# matches the progress lines generate_iot_batch.py prints, e.g.:
#   "  ... 500,000/5,000,000 rows written"
_GEN_PROGRESS_RE = re.compile(r"([\d,]+)\s*/\s*([\d,]+)\s+rows written")


BATCH_LOAD_LOG_NAME = "iot-batch-load"


def _run_batch_load(total_rows: int):
    """Background worker: shell out to generate_iot_batch.py, then bulk-load via gpfdist."""
    with BATCH_LOAD_LOCK:
        BATCH_LOAD_STATE.update({
            "running": True, "total": total_rows, "loaded": 0, "error": None,
            "started_at": datetime.now().isoformat(), "finished_at": None,
            "stop_requested": False, "stage": "generating",
            "script_path": None, "generator_pid": None,
        })

    conn = None
    proc = None
    fpath = None
    logf = open(log_file(BATCH_LOAD_LOG_NAME), "w")
    try:
        script = find_generate_script()
        logf.write(f"[{datetime.now().isoformat()}] resolved script: {script}\n")
        logf.flush()
        if not script:
            raise RuntimeError(
                "generate_iot_batch.py not found (checked generators/, scripts/, "
                "dashboards/, and GENERATE_IOT_BATCH_SCRIPT env var)")
        with BATCH_LOAD_LOCK:
            BATCH_LOAD_STATE["script_path"] = str(script)

        ok, msg = _start_gpfdist()
        logf.write(f"[{datetime.now().isoformat()}] gpfdist: {msg}\n")
        logf.flush()
        if not ok:
            raise RuntimeError(msg)

        BATCH_LOAD_DIR.mkdir(parents=True, exist_ok=True)
        for f in BATCH_LOAD_DIR.glob("iot_batch_*.csv"):
            f.unlink(missing_ok=True)

        fname = f"iot_batch_{int(time.time())}.csv"
        fpath = BATCH_LOAD_DIR / fname

        # ── Stage 1: generate the CSV, streaming its progress output ────────────
        cmd = [sys.executable, str(script), str(fpath), str(total_rows)]
        logf.write(f"[{datetime.now().isoformat()}] launching: {' '.join(cmd)}\n")
        logf.flush()
        proc = subprocess.Popen(
            cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1,
        )
        with BATCH_LOAD_LOCK:
            BATCH_LOAD_STATE["generator_pid"] = proc.pid
        write_pid("iot-batch-generator", proc.pid)
        logf.write(f"[{datetime.now().isoformat()}] generator PID {proc.pid} started\n")
        logf.flush()

        for line in proc.stdout:
            logf.write(line if line.endswith("\n") else line + "\n")
            logf.flush()
            m = _GEN_PROGRESS_RE.search(line)
            if m:
                written = int(m.group(1).replace(",", ""))
                with BATCH_LOAD_LOCK:
                    BATCH_LOAD_STATE["loaded"] = written
            with BATCH_LOAD_LOCK:
                if BATCH_LOAD_STATE["stop_requested"]:
                    proc.terminate()
                    break
        proc.wait(timeout=30)
        pid_file("iot-batch-generator").unlink(missing_ok=True)
        logf.write(f"[{datetime.now().isoformat()}] generator exited with code {proc.returncode}\n")
        logf.flush()

        with BATCH_LOAD_LOCK:
            stopped = BATCH_LOAD_STATE["stop_requested"]
        if stopped:
            raise RuntimeError("Stopped by user during CSV generation")
        if proc.returncode != 0:
            raise RuntimeError(f"generate_iot_batch.py exited with code {proc.returncode} — see batch-load log")
        if not fpath.exists() or fpath.stat().st_size == 0:
            raise RuntimeError(f"generate_iot_batch.py finished but {fpath} is missing/empty")

        # ── Stage 2: load the single CSV into WarehousePG via gpfdist ───────────
        with BATCH_LOAD_LOCK:
            BATCH_LOAD_STATE["stage"] = "loading"
            BATCH_LOAD_STATE["loaded"] = total_rows  # generation confirmed complete

        logf.write(f"[{datetime.now().isoformat()}] CSV ready ({fpath.stat().st_size:,} bytes) — "
                   f"creating external table and loading\n")
        logf.flush()

        conn = get_conn()
        conn.autocommit = False
        cur = conn.cursor()

        ext_table = "ext_iot_batch_stage"
        cur.execute(f"DROP EXTERNAL TABLE IF EXISTS {ext_table}")
        cur.execute(f"""
            CREATE EXTERNAL TABLE {ext_table} (
                timestamp     timestamp,
                sensor_id     varchar(20),
                location      varchar(100),
                temperature   decimal(5,2),
                humidity      decimal(5,2),
                pressure      decimal(6,2),
                battery_level decimal(5,2),
                status        varchar(20)
            )
            LOCATION ('gpfdist://{GPFDIST_HOST}:{GPFDIST_PORT}/{fname}')
            FORMAT 'CSV' (HEADER)
        """)

        # Same computed-column logic FlowServer applies on the streaming path,
        # reproduced here so batch-loaded rows look consistent with streamed ones.
        # location format from generate_iot_batch.py is "<Building>-Floor-<N>".
        cur.execute(f"""
            INSERT INTO public.iot_sensor_readings
                (timestamp, sensor_id, location, temperature, humidity, pressure,
                 battery_level, status, alert_level, building, floor,
                 temperature_f, comfort_index, battery_status, processed_at, data_quality)
            SELECT
                timestamp, sensor_id, location, temperature, humidity, pressure,
                battery_level, status,
                CASE WHEN status = 'low_battery' THEN 2
                     WHEN status IN ('high_temp','low_temp') THEN 2
                     WHEN status = 'high_humidity' THEN 1
                     ELSE 0 END AS alert_level,
                split_part(location, '-Floor-', 1) AS building,
                NULLIF(split_part(location, '-Floor-', 2), '')::int AS floor,
                ROUND(temperature * 9.0/5 + 32, 2) AS temperature_f,
                CASE WHEN temperature BETWEEN 20 AND 26 AND humidity BETWEEN 30 AND 60 THEN 'comfortable'
                     WHEN temperature BETWEEN 18 AND 28 THEN 'acceptable'
                     ELSE 'uncomfortable' END AS comfort_index,
                CASE WHEN battery_level >= 80 THEN 'full'
                     WHEN battery_level >= 40 THEN 'ok'
                     WHEN battery_level >= 20 THEN 'low'
                     ELSE 'critical' END AS battery_status,
                now() AS processed_at,
                'batch_gpfdist' AS data_quality
            FROM {ext_table}
        """)
        conn.commit()
        logf.write(f"[{datetime.now().isoformat()}] INSERT ... SELECT committed\n")
        logf.flush()

        cur.execute(f"DROP EXTERNAL TABLE IF EXISTS {ext_table}")
        conn.commit()
        cur.close(); conn.close()

        fpath.unlink(missing_ok=True)

        with BATCH_LOAD_LOCK:
            BATCH_LOAD_STATE["running"] = False
            BATCH_LOAD_STATE["stage"] = "done"
            BATCH_LOAD_STATE["finished_at"] = datetime.now().isoformat()
        logf.write(f"[{datetime.now().isoformat()}] done\n")

    except Exception as e:
        logf.write(f"[{datetime.now().isoformat()}] ERROR: {e}\n")
        if proc and proc.poll() is None:
            try: proc.terminate()
            except Exception: pass
        if conn:
            try: conn.rollback(); conn.close()
            except Exception: pass
        if fpath:
            try: fpath.unlink(missing_ok=True)
            except Exception: pass
        pid_file("iot-batch-generator").unlink(missing_ok=True)
        with BATCH_LOAD_LOCK:
            BATCH_LOAD_STATE["running"] = False
            BATCH_LOAD_STATE["error"] = str(e)
            BATCH_LOAD_STATE["finished_at"] = datetime.now().isoformat()
    finally:
        logf.close()


@app.route("/api/iot/batch-load/start", methods=["POST"])
def iot_batch_load_start():
    body = request.get_json(silent=True) or {}
    total_rows = int(body.get("total_rows", 1000000))

    with BATCH_LOAD_LOCK:
        if BATCH_LOAD_STATE["running"]:
            return jsonify({"ok": False, "error": "Batch load already running"}), 400

    t = threading.Thread(target=_run_batch_load, args=(total_rows,), daemon=True)
    t.start()
    return jsonify({"ok": True, "message": f"Batch load started: {total_rows:,} rows"})


