            inserted_ids = []
            for i in range(n):
                account_id = next_id + i
                consumer_id = random.randint(1000, 9999)
                lender_id = random.randint(1, 20)
                product = random.choice(products)
                sanctioned = round(random.uniform(1000, 50000), 2)
                outstanding = round(sanctioned * random.uniform(0.1, 0.95), 2)
                dpd_bucket = random.choice(dpd_buckets)
                status = random.choice(statuses)

                cur.execute("""
                    INSERT INTO oltp.credit_accounts
                        (account_id, consumer_id, lender_id, product, sanctioned_amount,
                         outstanding_amount, dpd_bucket, status, opened_ts, event_ts)
                    VALUES (%s, %s, %s, %s, %s, %s, %s, %s,
                            now() - (random() * interval '365 days'), now())
                """, (account_id, consumer_id, lender_id, product, sanctioned,
                      outstanding, dpd_bucket, status))
                inserted_ids.append(account_id)

            conn.commit()
            cur.close(); conn.close()
            return jsonify({"ok": True, "inserted": n, "ids": inserted_ids, "table": table,
                            "message": f"Inserted {n} row(s) into oltp.credit_accounts on EPAS — "
                                       f"check the credit_accounts ticker below once Debezium/FlowServer catch up."})

        else:  # bureau_score_events
            cur.execute("SELECT COALESCE(MAX(score_event_id), 100000) FROM oltp.bureau_score_events")
            next_id = cur.fetchone()[0] + 1

            triggers = ["new_inquiry", "account_update", "delinquency", "payoff", "periodic_refresh"]

            inserted_ids = []
            for i in range(n):
                score_event_id = next_id + i
                consumer_id = random.randint(1000, 9999)
                score_value = random.randint(300, 850)
                score_version = random.choice(["v3.0", "v4.0"])
                score_trigger = random.choice(triggers)

                cur.execute("""
                    INSERT INTO oltp.bureau_score_events
                        (score_event_id, consumer_id, score_value, score_version, score_trigger, score_ts)
                    VALUES (%s, %s, %s, %s, %s, now())
                """, (score_event_id, consumer_id, score_value, score_version, score_trigger))
                inserted_ids.append(score_event_id)

            conn.commit()
            cur.close(); conn.close()
            return jsonify({"ok": True, "inserted": n, "ids": inserted_ids, "table": table,
                            "message": f"Inserted {n} row(s) into oltp.bureau_score_events on EPAS — "
                                       f"check the bureau_score_events ticker below once Debezium/FlowServer catch up."})

    except Exception as e:
        if conn:
            try: conn.rollback(); conn.close()
            except Exception: pass
        return jsonify({"ok": False, "error": str(e)}), 400


@app.route("/api/cdc/update_test_rows", methods=["POST"])
def cdc_update_test_rows():
    """
    Mutate EXISTING rows on EPAS (rather than inserting new ones) so the merge/upsert
    path on the WarehousePG side can be observed: the target row should update in
    place (same account_id), not appear as a duplicate.
    """
    body = request.get_json(silent=True) or {}
    n = max(1, min(int(body.get("n", 3)), 100))

    conn = None
    try:
        conn = get_sql_conn("epas_tu")
        cur = conn.cursor()

        cur.execute("""
            SELECT account_id, outstanding_amount FROM oltp.credit_accounts
            ORDER BY random() LIMIT %s
        """, (n,))
        rows = cur.fetchall()
        if not rows:
            cur.close(); conn.close()
            return jsonify({
                "ok": False,
                "error": "No existing rows in oltp.credit_accounts to update — "
                         "insert test rows first, then try Simulate Update.",
            }), 400

        dpd_buckets = ["current", "30", "60", "90+"]
        statuses    = ["active", "delinquent", "closed"]

        updated = []
        for account_id, outstanding in rows:
            # simulate a partial paydown rather than a random jump, so the change is realistic
            new_outstanding = round(float(outstanding) * random.uniform(0.70, 0.98), 2)
            new_dpd = random.choice(dpd_buckets)
            new_status = random.choice(statuses)

            cur.execute("""
                UPDATE oltp.credit_accounts
                SET outstanding_amount = %s, dpd_bucket = %s, status = %s, event_ts = now()
                WHERE account_id = %s
            """, (new_outstanding, new_dpd, new_status, account_id))
            updated.append({
                "account_id": account_id,
                "outstanding_amount": new_outstanding,
                "dpd_bucket": new_dpd,
                "status": new_status,
            })

        conn.commit()
        cur.close(); conn.close()
        return jsonify({
            "ok": True, "updated": updated,
            "message": f"Updated {len(updated)} existing row(s) in oltp.credit_accounts on EPAS — "
                       f"the same account_id should update IN PLACE in tu_bureau_demo.credit_accounts "
                       f"(merge/upsert), not appear as a new row.",
        })
    except Exception as e:
        if conn:
            try: conn.rollback(); conn.close()
            except Exception: pass
        return jsonify({"ok": False, "error": str(e)}), 400


