@app.route("/api/cdc/jobs/<job_name>/submit", methods=["POST"])
def cdc_job_submit(job_name):
    yaml_rel = CDC_JOBS.get(job_name)
    if not yaml_rel:
        return jsonify({"ok": False, "error": f"Unknown CDC job: {job_name}"}), 400
    yaml_path = REPO_DIR / yaml_rel
    if not yaml_path.exists():
        return jsonify({"ok": False, "error": f"YAML not found: {yaml_path}"}), 400
    # these jobs need an explicit --name (the YAML itself has no job-name field)
    r = flowcli("submit", "--name", job_name, str(yaml_path))
    return jsonify({"ok": r["ok"], "output": r["stdout"] or r["stderr"]})


