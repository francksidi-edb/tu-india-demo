    """Quick-start queries per connection, shown as buttons in the editor."""
    return jsonify(SQL_EDITOR_PRESET_QUERIES)


@app.route("/api/sqleditor/query", methods=["POST"])
def sqleditor_query():
    """Run a single SQL statement against one of the preset connections."""
    body    = request.get_json(silent=True) or {}
    conn_id = body.get("conn")
    sql     = (body.get("sql") or "").strip()
    confirm = bool(body.get("confirm"))

    if not conn_id or conn_id not in SQL_CONN_PRESETS:
        return jsonify({"ok": False, "error": f"Unknown connection: {conn_id}"}), 400
    if not sql:
        return jsonify({"ok": False, "error": "Empty query"}), 400

    # crude single-statement guard — avoid ; a; b; stacked statements
    if ";" in sql.rstrip().rstrip(";"):
        return jsonify({"ok": False, "error": "Only a single statement is allowed per run"}), 400

    if DESTRUCTIVE_SQL_RE.search(sql) and not confirm:
        return jsonify({
            "ok": False, "needs_confirm": True,
            "error": "This looks like a data-changing statement "
                     "(DROP/DELETE/TRUNCATE/ALTER/UPDATE/INSERT/GRANT/REVOKE/CREATE). "
                     "Resend with confirm:true to proceed.",
        }), 400

    conn = None
    t0 = time.time()
    try:
        conn = get_sql_conn(conn_id)
        cur = conn.cursor()
        cur.execute("SET LOCAL statement_timeout = '15000'")  # 15s, milliseconds
        cur.execute(sql)
        elapsed = round(time.time() - t0, 3)

        if cur.description:
            cols = [d[0] for d in cur.description]
            raw_rows = cur.fetchmany(500)
            rows = [[_jsonable(v) for v in r] for r in raw_rows]
            conn.commit()
            return jsonify({
                "ok": True, "columns": cols, "rows": rows,
                "row_count": len(rows), "truncated": len(rows) == 500,
                "elapsed": elapsed,
            })
        else:
            affected = cur.rowcount
            conn.commit()
            return jsonify({
                "ok": True, "columns": [], "rows": [],
                "affected": affected, "elapsed": elapsed,
            })
    except Exception as e:
        if conn:
            try: conn.rollback()
            except Exception: pass
        return jsonify({"ok": False, "error": str(e)}), 400
    finally:
        if conn:
            try: conn.close()
            except Exception: pass


