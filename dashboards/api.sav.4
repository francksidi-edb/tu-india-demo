@app.route("/api/cdc/jobs/start_all", methods=["POST"])
def cdc_jobs_start_all():
    """Submit (idempotent) then start all CDC jobs in one click."""
    steps, errors = [], []
    for name, yaml_rel in CDC_JOBS.items():
        yaml_path = REPO_DIR / yaml_rel
        if not yaml_path.exists():
            errors.append(f"{name}: YAML not found ({yaml_path})")
            continue
        r_sub = flowcli("submit", "--name", name, str(yaml_path))
        sub_out = (r_sub["stdout"] or r_sub["stderr"])
        r_start = flowcli("start", name)
        start_out = (r_start["stdout"] or r_start["stderr"])
        if r_start["ok"] or "already" in start_out.lower():
            steps.append(f"{name}: started")
        else:
            errors.append(f"{name}: submit={sub_out or 'ok'} / start={start_out}")
    return jsonify({"ok": len(errors) == 0, "steps": steps, "errors": errors})


