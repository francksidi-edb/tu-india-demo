#  DB HELPERS
# ══════════════════════════════════════════════════════════════════════════════

def get_conn():
    return psycopg2.connect(**DB_CONFIG)


def q(sql, params=None):
    conn = get_conn()
    cur  = conn.cursor(cursor_factory=psycopg2.extras.RealDictCursor)
    cur.execute(sql, params or ())
    rows = cur.fetchall()
    cur.close(); conn.close()
    return [dict(r) for r in rows]


def q1(sql, params=None):
    rows = q(sql, params)
    return rows[0] if rows else {}


def get_sql_conn(preset_id: str):
    """Connect using one of the SQL Editor presets (EPAS or WarehousePG)."""
    preset = SQL_CONN_PRESETS.get(preset_id)
    if not preset:
        raise ValueError(f"Unknown connection: {preset_id}")
    return psycopg2.connect(
        host=preset["host"], port=preset["port"],
        user=preset["user"], password=preset["password"],
        dbname=preset["database"], connect_timeout=5,
    )


def _jsonable(v):
    """Make a single DB cell JSON-safe (Decimal/datetime/etc -> str)."""
    if v is None or isinstance(v, (int, float, str, bool)):
        return v
    return str(v)


