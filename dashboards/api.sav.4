CDC_SLOT_NAME  = os.environ.get("CDC_SLOT_NAME", "debezium_tu_slot")
CDC_PUB_NAME   = os.environ.get("CDC_PUB_NAME", "debezium_tu_publication")


@app.route("/api/cdc/status")
def cdc_status():
    """Combined health of the TU CDC pipeline: EPAS source + WarehousePG target."""
    result = {"ok": False, "epas": {"ok": False}, "whpg": {"ok": False}}

    # ── EPAS side: replication slot, publication, source row counts ──────────
    try:
        conn = get_sql_conn("epas_tu")
        cur = conn.cursor(cursor_factory=psycopg2.extras.RealDictCursor)

        cur.execute("""SELECT slot_name, active, active_pid, restart_lsn, confirmed_flush_lsn
                       FROM pg_replication_slots WHERE slot_name = %s""", (CDC_SLOT_NAME,))
        slot = cur.fetchone()

        cur.execute("SELECT 1 FROM pg_publication WHERE pubname = %s", (CDC_PUB_NAME,))
        pub_exists = cur.fetchone() is not None

        cur.execute("SELECT COUNT(*) AS cnt FROM oltp.credit_accounts")
        ca_cnt = cur.fetchone()["cnt"]
        cur.execute("SELECT COUNT(*) AS cnt FROM oltp.bureau_score_events")
        bse_cnt = cur.fetchone()["cnt"]

        cur.close(); conn.close()
        result["epas"] = {
            "ok": True,
            "slot": {k: _jsonable(v) for k, v in dict(slot).items()} if slot else None,
            "publication_exists": pub_exists,
            "credit_accounts": int(ca_cnt),
            "bureau_score_events": int(bse_cnt),
        }
    except Exception as e:
        result["epas"] = {"ok": False, "error": str(e)}

    # ── WarehousePG side: target row counts + freshness ───────────────────────
    try:
        conn = get_sql_conn("whpg_tu")
        cur = conn.cursor(cursor_factory=psycopg2.extras.RealDictCursor)

        cur.execute("SELECT COUNT(*) AS cnt, MAX(event_ts) AS latest FROM tu_bureau_demo.credit_accounts")
        ca = cur.fetchone()
        cur.execute("SELECT COUNT(*) AS cnt, MAX(score_ts) AS latest FROM tu_bureau_demo.bureau_score_events")
        bse = cur.fetchone()

        cur.close(); conn.close()
        result["whpg"] = {
            "ok": True,
            "credit_accounts":     {"count": int(ca["cnt"]),      "latest": str(ca["latest"] or "")},
            "bureau_score_events": {"count": int(bse["cnt"]),     "latest": str(bse["latest"] or "")},
        }
    except Exception as e:
        result["whpg"] = {"ok": False, "error": str(e)}

    result["ok"] = result["epas"].get("ok", False) or result["whpg"].get("ok", False)
    return jsonify(result)


@app.route("/api/cdc/recent")
def cdc_recent():
    """Recent rows landing in WarehousePG, for a live ticker."""
    out = {"credit_accounts": [], "bureau_score_events": []}

    try:
        conn = get_sql_conn("whpg_tu")
        cur = conn.cursor(cursor_factory=psycopg2.extras.RealDictCursor)

        try:
            cur.execute("""
                SELECT account_id, consumer_id, lender_id, product, outstanding_amount,
                       dpd_bucket, status, event_ts, ingested_ts
                FROM tu_bureau_demo.credit_accounts
                ORDER BY ingested_ts DESC LIMIT 20""")
            out["credit_accounts"] = [dict(r) for r in cur.fetchall()]
        except Exception as e:
            out["credit_accounts_error"] = str(e)
            conn.rollback()

        try:
            cur.execute("""
                SELECT * FROM tu_bureau_demo.bureau_score_events
                ORDER BY score_ts DESC LIMIT 20""")
            out["bureau_score_events"] = [dict(r) for r in cur.fetchall()]
        except Exception as e:
            out["bureau_score_events_error"] = str(e)
            conn.rollback()

        cur.close(); conn.close()
    except Exception as e:
        out["error"] = str(e)

    # make every value JSON-safe (Decimal/datetime -> str)
    for key in ("credit_accounts", "bureau_score_events"):
        out[key] = [{k: _jsonable(v) for k, v in row.items()} for row in out[key]]

    return jsonify(out)


@app.route("/api/cdc/jobs")
